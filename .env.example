AZURE_OPENAI_ENDPOINT=https://your-text-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-text-api-key
AZURE_OPENAI_DEPLOYMENT=your-text-deployment

AZURE_TRANSCRIPTION_ENDPOINT=https://your-transcription-resource.openai.azure.com
AZURE_TRANSCRIPTION_API_KEY=your-transcription-api-key
AZURE_TRANSCRIPTION_DEPLOYMENT=your-transcription-deployment
AZURE_TRANSCRIPTION_API_VERSION=2025-03-01-preview

SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=your-sql-server,1433
SQL_DATABASE=MorningTalk
SQL_USERNAME=your-application-login
SQL_PASSWORD=your-sql-password
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
SQL_CONNECTION_TIMEOUT=15
SQL_EXPECTED_DATABASE=MorningTalk
SQL_EXPECTED_LOGIN=your-application-login
SQL_EXPECTED_TCP_PORT=1433
